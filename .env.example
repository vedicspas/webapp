# ---- Database (apps/api) ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=vedic
DATABASE_PASSWORD=vedicpassword
DATABASE_NAME=vedic_spas

# ---- API server ----
API_PORT=4100
API_ORIGIN=http://localhost:4100
WEB_ORIGIN=http://localhost:3000

# Shared secret used to sign/verify JWTs between Auth.js (web) and the Fastify API.
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-real-secret
# Public URL of the web app (browser). Required in Docker so Auth.js sign-out /
# OAuth redirects are not built from the container hostname.
AUTH_URL=http://localhost:3000

# ---- Stripe (Connect platform account) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Platform commission on prepaid/deposit bookings, in basis points (750 = 7.5%)
PLATFORM_FEE_BPS=750
# Fixed booking fee amount in minor units (e.g. 500 = $5.00) for the "booking fee" mode default
DEFAULT_BOOKING_FEE_MINOR=500

# Local folder for vendor spa photos (not cloud blob storage). Docker overrides this.
# UPLOAD_DIR=

# ---- Google OAuth (Auth.js) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Shopify Storefront API ----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ---- Next.js public vars (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
